[Unit]
Description=TuxBar - Dynamic Touch Bar Engine for Linux (MPRIS & Widgets)
Documentation=https://github.com/mylnzon58/tuxbar
After=systemd-user-sessions.service udev.service
Conflicts=tiny-dfr.service

[Service]
Type=simple
Environment="DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus"
ExecStart=/usr/local/bin/tuxbar run
Restart=always
RestartSec=2s
TimeoutStopSec=3s
KillMode=process
StandardOutput=journal
StandardError=journal

# Security Hardening
ProtectSystem=full
ProtectHome=read-only
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target

